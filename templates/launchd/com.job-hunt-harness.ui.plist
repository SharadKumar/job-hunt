<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Local approval UI, kept running by launchd.

  Rendered and installed by scripts/install-ui-launchd.sh, which substitutes
  this checkout's path, the current PATH and the port. Do not copy this file
  into ~/Library/LaunchAgents by hand; the placeholders are taken literally.

  It binds 127.0.0.1 only, so nothing outside this machine can reach it and no
  token is needed. The installer additionally registers a portless route when
  portless is on PATH, so the same local server answers on
  https://job-hunt.localhost as well; that proxy is local too and changes
  nothing about the binding here.

  To reach it from a phone, keep the loopback bind and put it behind
  `tailscale serve --bg __PORT__`, which proxies your tailnet only. Then set
  HARNESS_UI_TOKEN=<long random value> in the checkout's ignored .env.local:
  the command below reads it from there, so the secret never sits in this
  plist, and every /api call then needs the token (paste it once in Settings
  on each browser). Kickstart the job after changing it.

  For a LAN bind instead, append --host <address>; the server refuses a
  non-local bind without the token.
-->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.job-hunt-harness.ui</string>
  <key>ProgramArguments</key>
  <array>
    <string>/bin/bash</string>
    <string>-c</string>
    <string>cd "__REPO_DIR__" &amp;&amp; t=$(sed -n 's/^HARNESS_UI_TOKEN=//p' .env.local 2&gt;/dev/null | tail -1); if [ -n "$t" ]; then export HARNESS_UI_TOKEN="$t"; fi; exec npm run -s ui -- --port __PORT__</string>
  </array>
  <key>WorkingDirectory</key>
  <string>__REPO_DIR__</string>
  <key>EnvironmentVariables</key>
  <dict>
    <key>REPO_DIR</key>
    <string>__REPO_DIR__</string>
    <key>TMPDIR</key>
    <string>/tmp</string>
    <key>PATH</key>
    <string>__PATH__</string>
    <!-- HARNESS_UI_TOKEN comes from .env.local; see the comment at the top. -->
  </dict>
  <key>RunAtLoad</key>
  <true/>
  <key>KeepAlive</key>
  <true/>
  <key>StandardOutPath</key>
  <string>__REPO_DIR__/state/journal/launchd/ui.log</string>
  <key>StandardErrorPath</key>
  <string>__REPO_DIR__/state/journal/launchd/ui.log</string>
</dict>
</plist>
