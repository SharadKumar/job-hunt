# Google service account JSON path (for Sheets + Drive + Calendar)
GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account.json
SHEETS_SPREADSHEET_ID=

# Which CLI runs the daily orchestrator (claude | codex)
# The orchestrator launches the agent CLI which uses ITS OWN subscription /
# auth for generative LLM reasoning. The bounded Jev decision layer uses the
# separate Vercel AI Gateway credential below.
HARNESS_CLI=claude

# Optional push channel for "drop everything" alerts
# NTFY_TOPIC=
# PUSHOVER_USER=
# PUSHOVER_TOKEN=

# Optional Gmail integration (uses GOOGLE_APPLICATION_CREDENTIALS by default)
# GMAIL_USER_EMAIL=
# Jev classification through Vercel AI Gateway. Store the real value only in
# ignored .env.local, never in this file or state/. A dedicated key with a
# small daily spend cap is recommended.
AI_GATEWAY_API_KEY=
# live calls the gateway, record calls it and stores typed responses under
# ignored state/jev/fixtures, replay refuses network and uses those fixtures.
JEV_MODE=live
