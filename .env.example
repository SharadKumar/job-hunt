# Google service account JSON path (for Sheets + Drive + Calendar)
GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account.json
SHEETS_SPREADSHEET_ID=

# Which CLI runs the daily orchestrator (claude | codex)
# The orchestrator launches the agent CLI which uses ITS OWN subscription /
# auth for LLM reasoning. The harness tools themselves never call the
# Anthropic SDK directly — all reasoning happens in-agent.
HARNESS_CLI=claude

# Optional push channel for "drop everything" alerts
# NTFY_TOPIC=
# PUSHOVER_USER=
# PUSHOVER_TOKEN=

# Optional Gmail integration (uses GOOGLE_APPLICATION_CREDENTIALS by default)
# GMAIL_USER_EMAIL=
