node_modules/
.env
.env.local
.DS_Store
*.log
dist/

# Regenerable golden binaries (the committed golden-page-*.png is the sign-off
# surface; golden.pdf/.html are reproducible via `npm run resume:design:golden`).
templates/resume/*/sample/golden.pdf
templates/resume/*/sample/golden.html

# Nested agent worktrees are registered git worktrees, not repo content.
# Git does not auto-ignore worktrees placed inside the working tree.
.claude/worktrees/

# Playwright MCP scratch output and archived templates.
.playwright-mcp/
templates/resume/_archived_*/

# skill-creator eval workspaces (fixture roots, run outputs)
.claude/skills/*-workspace/
!tests/fixtures/**/*.log

# Personal state never enters git: profile, CV, pipeline, audit, journals,
# credentials, browser sessions, keys and the private leak-terms list.
# Only the two example files below are tracked. tools/leak-check.ts (the
# pre-commit hook) blocks staged state/ paths as a second guard.
state/*
!state/org/
state/org/*
!state/org/resume-formats.yaml
!state/org/resume-types.example.yaml
