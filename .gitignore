node_modules/
.env
.env.local
state/journal/launchd/*.log
state/pipeline/archive/**/confirmation.png
state/channels/storage-state/*.json
.DS_Store
*.log
dist/

# Regenerable golden binaries (the committed golden-page-*.png is the sign-off
# surface; golden.pdf/.html are reproducible via `npm run resume:design:golden`).
templates/resume/*/sample/golden.pdf
templates/resume/*/sample/golden.html

# Baseline presentation HTML embeds base64 fonts — regenerable, keep out of git.
state/profile/resumes/*/*.html

# Nested agent worktrees are registered git worktrees, not repo content.
# Git does not auto-ignore worktrees placed inside the working tree.
.claude/worktrees/

# Live SEEK / LinkedIn browser sessions (cookies, tokens). Per-user secret; never commit.
state/channels/chrome-profile/
.playwright-mcp/

# CV and resume content (real person). Never on a remote.
state/profile/cv/
state/profile/cv-source.md
state/profile/voice-samples.md
state/profile/resumes/
state/profile/profile-report.html
state/profiles/
state/pipeline/archive/
state/org/team-report.html
templates/resume/_archived_*/

# Onboarded-user state: identity, positionings, pipeline, audit, journal. Never on a remote.
state/profile/
state/pipeline/
state/audit/
state/journal/
state/contacts/
state/market/
state/rejected/
state/org/team.yaml
state/org/keyword-clouds.yaml
state/org/resume-types.yaml

# Optional list of personal terms tests/profile-template.test.ts must not find in the public skeleton.
state/leak-terms.txt

# skill-creator eval workspaces (fixture roots, run outputs)
.claude/skills/*-workspace/
